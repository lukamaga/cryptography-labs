V=[81171993294, 85439519898, 74519040083, 93673032393, 73004362750, 78902131325, 85540280960, 84368639224]
p=105682042460
w_1=9610068078
v_1=V[0] # t*v_1=w_1 mod p
C=[91723484110, 6183203150, 22125745954, 32963114285, 812342718, 74519040083, 27496606386, 32963114285, 22125745954, 34134756021, 32963114285, 812342718]
# gcd(v_1, p) is 1
t=w_1/v_1%p
Cn=[c*t%p for c in C]
# Reikia passimti nuo 11-18 (nuo galo)
text=''
for i in Cn:
    text += chr(int(bin(i)[-18:-10], 2))
    
print(text)
